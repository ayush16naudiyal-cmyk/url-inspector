{
  "name": "url-inspector",
  "version": "1.0.0",
  "description": "Shows what happens when a URL is requested: DNS, TCP, TLS, HTTP timings, certificate, redirects and security headers.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  }
}
